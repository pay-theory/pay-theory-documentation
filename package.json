    "qs": "^6.16.0",
    "serialize-javascript": "^7.0.5",
    "shell-quote": "^1.9.0",
    "svgo": "^3.3.5",
    "uuid": "^11.1.1",
    "webpack": "^5.104.1",
    "webpack-dev-server": "^5.2.6",
    "websocket-driver": "^0.7.5",
    "ws": "^8.21.0",
    "yaml": "^2.8.3"
  }
