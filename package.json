{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "lint": "eslint -c .eslintrc.json --ext .ts,.tsx './src/**/*.{ts,tsx,js,jsx}'",
    "lint:fix": "npm run lint -- --fix",
    "check-ts": "tsc --noEmit -p ./tsconfig.json",
    "prettier": "npx prettier -c './src/**/*.{ts,tsx,js,jsx}'",
    "prettier:fix": "npx prettier --write './src/**/*.{ts,tsx,js,jsx}'",
    "prepare": "husky"
  },
  "dependencies": {
    "@algolia/autocomplete-js": "^1.17.6",
    "@algolia/autocomplete-theme-classic": "^1.17.6",
    "@docusaurus/core": "^3.5.2",
    "@docusaurus/plugin-sitemap": "^3.5.2",
    "@docusaurus/preset-classic": "^3.5.2",
    "@docusaurus/theme-search-algolia": "^3.5.2",
    "@mdx-js/react": "^3.1.0",
    "algoliasearch": "^5.10.2",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "prism-react-renderer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.5.2",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "docusaurus-plugin-typedoc": "^1.0.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typedoc": "^0.26.10",
    "typedoc-plugin-markdown": "^4.2.9"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=16.14"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npm run prettier:fix",
      "npm run lint:fix"
    ]
  }
}
