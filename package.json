{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "check-ts": "tsc --noEmit -p ./tsconfig.json",
    "prettier": "npx prettier -c './src/**/*.{ts,tsx,js,jsx}'",
    "prettier:fix": "npx prettier --write './src/**/*.{ts,tsx,js,jsx}'",
    "prepare": "husky"
  },
  "dependencies": {
    "@algolia/autocomplete-js": "^1.19.2",
    "@algolia/autocomplete-theme-classic": "^1.19.2",
    "@docusaurus/core": "^3.8.1",
    "@docusaurus/plugin-client-redirects": "^3.8.1",
    "@docusaurus/plugin-sitemap": "^3.8.1",
    "@docusaurus/preset-classic": "^3.8.1",
    "@docusaurus/theme-mermaid": "^3.8.1",
    "@docusaurus/theme-search-algolia": "^3.8.1",
    "@graphql-docs/generator": "file:../../../Personal/graphql-doc",
    "@mdx-js/react": "^3.1.0",
    "algoliasearch": "^5.10.2",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "docusaurus-plugin-typedoc": "^1.4.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.0",
    "typedoc": "^0.28.5",
    "typedoc-plugin-markdown": "^4.7.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=16.14"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npm run prettier:fix",
      "npm run lint:fix"
    ]
  },
  "overrides": {
    "webpack-dev-server": "^5.2.2"
  }
}
