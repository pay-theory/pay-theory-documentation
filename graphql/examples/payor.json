    "operation": "payors",
    "operationType": "query",
    "examples": [
      {
        "name": "List payors",
        "query": "query Payors($query: SqlQuery, $limit: Int) {\r\n    payors(query: $query, limit: $limit) {\r\n      items {\r\n        payor_id\r\n        merchant_uid\r\n        full_name\r\n        email\r\n        phone\r\n        address_line1\r\n        city\r\n        region\r\n        postal_code\r\n        country\r\n      }\r\n      total_row_count\r\n    }\r\n  }",
        "variables": {
          "query": {
            "query_list": [
              {
                "key": "merchant_uid",
                "value": "<MERCHANT_UID>",
                "operator": "EQUAL"
              }
            ]
          },
          "limit": 2
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "payors": {
                "items": [
                  {
                    "payor_id": "ptl_pay_10juZtcNdkEUTxm0SaepXH",
                    "merchant_uid": "<MERCHANT_UID>",
                    "full_name": "E2E Checkout",
                    "email": "e2e-checkout@example.test",
                    "phone": null,
                    "address_line1": "123 Test Street",
                    "city": "Cincinnati",
                    "region": "OH",
                    "postal_code": "45202",
                    "country": "USA"
                  },
                  {
                    "payor_id": "ptl_pay_11Tvd4EamaiPn90XGtfqdD",
