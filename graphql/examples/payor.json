  {
    "operation": "updatePayor",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Update a full payor",
        "query": "mutation UpdatePayor($payor_id: String!, $payor_data: PayorData!) {\r\n    updatePayor(payor_id: $payor_id, payor_data: $payor_data)\r\n  }",
        "variables": {
          "payor_id": "ptl_pay_6tOEQ5lesXwGSGaKECSfJy",
          "payor_data": {
            "full_name": "Jane Payor Updated",
            "email": "updated@example.com",
            "phone": "+15555550124",
            "address_line1": "456 Updated Street",
            "address_line2": "Suite 300",
            "city": "Columbus",
            "region": "OH",
            "postal_code": "43004",
            "country": "USA"
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "updatePayor": true
            }
          }
        },
        "description": "Updates all common fields on an existing payor."
      },
