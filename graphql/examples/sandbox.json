    "operationType": "mutation",
    "examples": [
      {
        "name": "Example createSandboxAchReturn",
        "description": "Use this mutation to create an ACH return for a completed ACH transaction.",
        "query": "mutation CreateSandboxAchReturn($input: CreateSandboxAchReturnInput!) {\n  createSandboxAchReturn(input: $input) {\n  ach_return_transaction_id\n  return_code\n  success\n  }\n}",
        "variables": {
          "input": {
            "transaction_id": "example",
            "return_code": "R01"
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createSandboxAchReturn": {
                "ach_return_transaction_id": "example",
                "return_code": "example",
                "success": true
              }
            }
          }
        }
      }
    ]
  },
