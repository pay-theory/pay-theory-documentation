  {
    "operation": "createPaymentMethod",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Save a card",
        "query": "mutation CreatePaymentMethod(\n  $merchant_uid: String!\n  $payment_method: PaymentMethodInput!\n) {\n  createPaymentMethod(\n    merchant_uid: $merchant_uid\n    payment_method: $payment_method\n  ) {\n    payment_method_id\n    merchant_uid\n    payment_type\n    last_four\n    card_brand\n    exp_date\n    full_name\n    is_active\n  }\n}",
        "variables": {
          "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
          "payment_method": {
            "card": {
              "card_number": "4835034598457895",
              "exp_date": {
                "month": "12",
                "year": "30"
              },
              "security_code": "123",
              "full_name": "Pat Theodore",
              "address_line1": "123 Test Street",
              "city": "Cincinnati",
              "region": "OH",
              "postal_code": "45209",
              "country": "USA"
            },
            "payor": {
              "full_name": "Pat Theodore",
              "email": "pat@paytheory.com",
              "phone": "+15555550123",
              "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1"
            }
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createPaymentMethod": {
                "payment_method_id": "ptl_pmt_54LidQwRcTs5MU9g0QYrgt",
                "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                "payment_type": "CARD",
                "last_four": "7895",
                "card_brand": "VISA",
                "exp_date": "1230",
                "full_name": "Pat Theodore",
                "is_active": true
              }
            }
          }
        },
        "description": "Saves a card as a payment method for later transactions. The response formats exp_date as MMYY (1230 means December 2030). An is_active value of true means the card can be used again."
      },
