[
  {
    "operation": "merchant",
    "operationType": "query",
    "examples": [
      {
        "name": "Get a merchant",
        "query": "query Merchant($merchant_uid: String) {\n  merchant(merchant_uid: $merchant_uid) {\n    merchant_uid\n    merchant_name\n    card_active\n    ach_active\n    cash_active\n    country_code\n    settings {\n      contact_email\n      website\n    }\n  }\n}",
        "variables": {
          "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "merchant": {
                "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                "merchant_name": "Northstar Books",
                "card_active": true,
                "ach_active": true,
                "cash_active": true,
                "country_code": "USA",
                "settings": {
                  "contact_email": null,
                  "website": null
                }
              }
            }
          }
        },
        "description": "Reads merchant details for the key."
      },
      {
        "name": "Merchant not found",
        "query": "query Merchant($merchant_uid: String) {\n  merchant(merchant_uid: $merchant_uid) {\n    merchant_uid\n    merchant_name\n    card_active\n    ach_active\n    cash_active\n    country_code\n    settings {\n      contact_email\n      website\n    }\n  }\n}",
        "variables": {
          "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1"
        },
        "response": {
          "type": "error",
          "httpStatus": 200,
          "body": {
            "data": {
              "merchant": null
            },
            "errors": [
              {
                "path": [
                  "merchant"
                ],
                "data": null,
                "errorType": "NOT_FOUND",
                "errorInfo": {
                  "arguments": {
                    "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1"
                  }
                },
                "message": "Merchant not found."
              }
            ]
          }
        },
        "description": "Returns an error when the merchant_uid does not exist."
      },
      {
        "name": "Read settings after the website update",
        "description": "This is a separate merchant query. It shows the contact and social settings cleared by the update.",
        "query": "query Merchant($merchant_uid: String) {\n  merchant(merchant_uid: $merchant_uid) {\n    merchant_uid\n    merchant_name\n    settings {\n      contact_email\n      contact_phone\n      facebook\n      instagram\n      linkedin\n      tiktok\n      twitter\n      website\n    }\n  }\n}",
        "variables": {
          "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "merchant": {
                "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                "merchant_name": "Northstar Books",
                "settings": {
                  "contact_email": null,
                  "contact_phone": null,
                  "facebook": null,
                  "instagram": null,
                  "linkedin": null,
                  "tiktok": null,
                  "twitter": null,
                  "website": "https://paytheory.com"
                }
              }
            }
          }
        }
      }
    ]
  },
  {
    "operation": "merchants",
    "operationType": "query",
    "examples": [
      {
        "name": "Get merchants",
        "query": "query Merchants($limit: Int) {\n  merchants(limit: $limit) {\n    items {\n      merchant_uid\n      merchant_name\n      card_active\n      ach_active\n      cash_active\n      country_code\n      parent_merchant_uid\n    }\n    total_row_count\n  }\n}",
        "variables": {
          "limit": 2
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "merchants": {
                "items": [
                  {
                    "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                    "merchant_name": "Northstar Books",
                    "card_active": true,
                    "ach_active": true,
                    "cash_active": true,
                    "country_code": "USA",
                    "parent_merchant_uid": null
                  }
                ],
                "total_row_count": 1
              }
            }
          }
        },
        "description": "Lists merchants visible to the key."
      },
      {
        "name": "Filter by merchant name",
        "query": "query Merchants($query: SqlQuery, $limit: Int) {\n  merchants(query: $query, limit: $limit) {\n    items {\n      merchant_uid\n      merchant_name\n      card_active\n      ach_active\n      cash_active\n      country_code\n      parent_merchant_uid\n    }\n    total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "key": "merchant_name",
                "value": "Northstar Books",
                "operator": "EQUAL"
              }
            ]
          },
          "limit": 2
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "merchants": {
                "items": [
                  {
                    "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                    "merchant_name": "Northstar Books",
                    "card_active": true,
                    "ach_active": true,
                    "cash_active": true,
                    "country_code": "USA",
                    "parent_merchant_uid": null
                  }
                ],
                "total_row_count": 1
              }
            }
          }
        },
        "description": "Filters visible merchants by merchant_name."
      }
    ]
  },
  {
    "operation": "createMerchant",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Create a merchant",
        "query": "mutation CreateMerchant(\n  $merchant_name: String!\n  $metadata: AWSJSON\n) {\n  createMerchant(\n    merchant_name: $merchant_name\n    metadata: $metadata\n  ) {\n    merchant_uid\n    merchant_name\n    parent_merchant_uid\n    ach_active\n    card_active\n    cash_active\n    country_code\n    is_system\n    submitted_onboarding\n    metadata\n  }\n}",
        "variables": {
          "merchant_name": "Northstar Books",
          "metadata": "{\"created_by\":\"docs-example\"}"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createMerchant": {
                "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                "merchant_name": "Northstar Books",
                "parent_merchant_uid": null,
                "ach_active": true,
                "card_active": true,
                "cash_active": true,
                "country_code": "USA",
                "is_system": false,
                "submitted_onboarding": true,
                "metadata": "{\"created_by\":\"docs-example\"}"
              }
            }
          }
        },
        "description": "Creates a merchant in Pay Theory to start the underwriting process."
      }
    ]
  },
