  {
    "operation": "updateMerchantSettings",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Set contact details and website",
        "description": "Sets a merchant's contact details and website.",
        "query": "mutation UpdateMerchantSettings($merchant_uid: ID!, $settings: MerchantSettingsInput!) {\n  updateMerchantSettings(merchant_uid: $merchant_uid, settings: $settings)\n}",
        "variables": {
          "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
          "settings": {
            "contact_email": "pat@paytheory.com",
            "contact_phone": "+14045551234",
            "website": "https://paytheory.com"
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "updateMerchantSettings": true
            }
          }
        }
      },
      {
        "name": "Update the website only",
        "description": "Settings updates replace the old settings. Send every field you want to keep; omitted settings are cleared.",
        "query": "mutation UpdateMerchantSettings($merchant_uid: ID!, $settings: MerchantSettingsInput!) {\n  updateMerchantSettings(merchant_uid: $merchant_uid, settings: $settings)\n}",
        "variables": {
          "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
          "settings": {
            "website": "https://paytheory.com"
          }
        },
        "response": {
