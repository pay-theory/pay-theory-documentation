[
  {
    "operation": "merchant",
    "operationType": "query",
    "examples": [
      {
        "name": "Example merchant",
        "description": "Returns merchant.",
        "query": "query Merchant($merchant_uid: String, $merchant_name: String) {\n  merchant(merchant_uid: $merchant_uid, merchant_name: $merchant_name) {\n  merchant_uid\n  ach_active\n  api_key\n  card_active\n  cash_active\n  }\n}",
        "variables": {
          "merchant_uid": "example",
          "merchant_name": "example"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "merchant": {
                "merchant_uid": "example",
                "ach_active": true,
                "api_key": "example",
                "card_active": true,
                "cash_active": true
              }
            }
          }
        }
      }
    ]
  },
  {
    "operation": "merchants",
    "operationType": "query",
    "examples": [
      {
        "name": "Example merchants",
        "description": "Returns merchants.",
        "query": "query Merchants($query: SqlQuery, $limit: Int, $offset: String, $direction: MoveDirection, $offset_id: String) {\n  merchants(query: $query, limit: $limit, offset: $offset, direction: $direction, offset_id: $offset_id) {\n  items {\n    merchant_uid\n    updated_row_at\n    ach_active\n    card_active\n    cash_active\n  }\n  total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "conjunctive_operator": "AND_NEXT"
              }
            ],
            "sort_list": [
              {
                "direction": "ASC"
              }
            ]
          },
          "limit": 123,
          "offset": "example",
          "direction": "BACKWARD",
          "offset_id": "example"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "merchants": {
                "items": [
                  {
                    "merchant_uid": "example",
                    "updated_row_at": "2025-01-01T00:00:00Z",
                    "ach_active": true,
                    "card_active": true,
                    "cash_active": true
                  }
                ],
                "total_row_count": 123
              }
            }
          }
        }
      }
    ]
  },
