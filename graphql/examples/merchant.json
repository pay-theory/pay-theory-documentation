  {
    "operation": "merchants",
    "operationType": "query",
    "examples": [
      {
        "name": "List merchants",
        "query": "query Merchants($limit: Int) {\n  merchants(limit: $limit) {\n    items {\n      merchant_uid\n      merchant_name\n      card_active\n      ach_active\n      cash_active\n      country_code\n      parent_merchant_uid\n    }\n    total_row_count\n  }\n}",
        "variables": {
          "limit": 2
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "merchants": {
                "items": [
                  {
                    "merchant_uid": "<MERCHANT_UID>",
                    "merchant_name": "<MERCHANT_NAME>",
                    "card_active": true,
                    "ach_active": true,
                    "cash_active": true,
                    "country_code": "USA",
                    "parent_merchant_uid": null
                  }
                ],
                "total_row_count": 1
              }
            }
          }
        },
        "description": "Lists merchants visible to the key."
      },
      {
        "name": "Filter by merchant name",
        "query": "query Merchants($query: SqlQuery, $limit: Int) {\n  merchants(query: $query, limit: $limit) {\n    items {\n      merchant_uid\n      merchant_name\n      card_active\n      ach_active\n      cash_active\n      country_code\n      parent_merchant_uid\n    }\n    total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "key": "merchant_name",
                "value": "<MERCHANT_NAME>",
                "operator": "EQUAL"
              }
            ]
          },
          "limit": 2
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "merchants": {
                "items": [
                  {
                    "merchant_uid": "<MERCHANT_UID>",
                    "merchant_name": "<MERCHANT_NAME>",
                    "card_active": true,
                    "ach_active": true,
                    "cash_active": true,
                    "country_code": "USA",
                    "parent_merchant_uid": null
                  }
                ],
                "total_row_count": 1
              }
            }
          }
        },
        "description": "Filters visible merchants by merchant_name."
      },
      {
