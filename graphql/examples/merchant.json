  {
    "operation": "merchant",
    "operationType": "query",
    "examples": [
      {
        "name": "Read a merchant",
        "query": "query Merchant($merchant_uid: String) {\r\n    merchant(merchant_uid: $merchant_uid) {\r\n      merchant_uid\r\n      merchant_name\r\n      card_active\r\n      ach_active\r\n      cash_active\r\n      country_code\r\n      settings {\r\n        contact_email\r\n        website\r\n      }\r\n    }\r\n  }",
        "variables": {
          "merchant_uid": "<MERCHANT_UID>"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "merchant": {
                "merchant_uid": "<MERCHANT_UID>",
                "merchant_name": "<MERCHANT_NAME>",
                "card_active": true,
                "ach_active": true,
                "cash_active": true,
                "country_code": "USA",
                "settings": {
                  "contact_email": null,
                  "website": null
                }
              }
            }
          }
        },
        "description": "Reads merchant details for the key."
      },
      {
