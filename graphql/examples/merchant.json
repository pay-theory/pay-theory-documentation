    "operation": "createMerchant",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Example createMerchant",
        "description": "Creates merchant.",
        "query": "mutation CreateMerchant($merchant_name: String!, $parent_merchant_uid: String, $user: MerchantUserInput, $metadata: AWSJSON) {\n  createMerchant(merchant_name: $merchant_name, parent_merchant_uid: $parent_merchant_uid, user: $user, metadata: $metadata) {\n  merchant_uid\n  updated_row_at\n  ach_active\n  card_active\n  cash_active\n  }\n}",
        "variables": {
          "merchant_name": "example",
          "parent_merchant_uid": "example",
          "user": {
            "email": "user@example.com",
            "first_name": "example",
            "last_name": "example",
            "phone": "+15555555555"
          },
          "metadata": {
            "key": "value"
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createMerchant": {
                "merchant_uid": "example",
                "updated_row_at": "2025-01-01T00:00:00Z",
                "ach_active": true,
                "card_active": true,
                "cash_active": true
              }
            }
          }
        }
      }
    ]
  },
