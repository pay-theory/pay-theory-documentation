  {
    "operation": "createMerchant",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Create a merchant",
        "query": "mutation CreateMerchant(\n  $merchant_name: String!\n  $metadata: AWSJSON\n) {\n  createMerchant(\n    merchant_name: $merchant_name\n    metadata: $metadata\n  ) {\n    merchant_uid\n    merchant_name\n    parent_merchant_uid\n    ach_active\n    card_active\n    cash_active\n    country_code\n    is_system\n    submitted_onboarding\n    metadata\n  }\n}",
        "variables": {
          "merchant_name": "e2e-doc-abca89f1-child",
          "metadata": "{\"created_by\":\"docs-example\"}"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createMerchant": {
                "merchant_uid": "<NEW_MERCHANT_UID>",
                "merchant_name": "e2e-doc-abca89f1-child",
                "parent_merchant_uid": null,
                "ach_active": true,
                "card_active": true,
                "cash_active": true,
                "country_code": "USA",
                "is_system": false,
                "submitted_onboarding": true,
                "metadata": "{\"created_by\":\"docs-example\"}"
              }
            }
          }
        },
        "description": "Creates a merchant with a partner key."
      },
