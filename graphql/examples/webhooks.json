        "query": "query WebhookEvents($id: ID, $endpoint: String, $result: WebhookNotificationResult, $last_evaluated_key: String, $limit: Int) {\n  webhookEvents(id: $id, endpoint: $endpoint, result: $result, last_evaluated_key: $last_evaluated_key, limit: $limit) {\n  last_evaluated_key\n  events {\n    id\n    endpoint\n    error\n    event\n    finished_at\n  }\n  }\n}",
