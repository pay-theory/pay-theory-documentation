    "operation": "webhooks",
    "operationType": "query",
    "examples": [
      {
        "name": "Example webhooks",
        "description": "Returns webhooks.",
        "query": "query Webhooks($endpoint: String) {\n  webhooks(endpoint: $endpoint) {\n  endpoint\n  is_active\n  name\n  }\n}",
        "variables": {
          "endpoint": "example"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "webhooks": {
                "endpoint": "example",
                "is_active": true,
                "name": "example"
              }
            }
          }
        }
      }
    ]
  },
