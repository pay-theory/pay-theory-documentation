    "examples": [
      {
        "name": "Example createWebhook",
        "description": "To create a webhook, you need to provide the endpoint and a name for the webhook using the following mutation:",
        "query": "mutation CreateWebhook($endpoint: String!, $name: String!) {\n  createWebhook(endpoint: $endpoint, name: $name)\n}",
        "variables": {
          "endpoint": "example",
          "name": "example"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createWebhook": true
            }
          }
        }
      }
    ]
  },
