    "operation": "settlements",
    "operationType": "query",
    "examples": [
      {
        "name": "Example settlements",
        "description": "Returns settlements.",
        "query": "query Settlements($query: SqlQuery, $limit: Int, $offset: String, $direction: MoveDirection, $offset_id: String) {\n  settlements(query: $query, limit: $limit, offset: $offset, direction: $direction, offset_id: $offset_id) {\n  items {\n    merchant_uid\n    settlement_date\n    currency\n    gross_amount\n    gross_amount_64bit\n  }\n  total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "conjunctive_operator": "AND_NEXT"
              }
            ],
            "sort_list": [
              {
                "direction": "ASC"
              }
            ]
          },
          "limit": 123,
          "offset": "example",
          "direction": "BACKWARD",
          "offset_id": "example"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "settlements": {
                "items": [
                  {
                    "merchant_uid": "example",
                    "settlement_date": "2025-01-01T00:00:00Z",
                    "currency": "example",
                    "gross_amount": 123,
                    "gross_amount_64bit": "example"
                  }
                ],
                "total_row_count": 123
              }
            }
          }
        }
      }
    ]
  },
  {
    "operation": "createBatchCapture",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Example createBatchCapture",
        "description": "This mutation will capture all PENDING transactions for a merchant in a batch and shortly after create a settlement for the merchant.",
        "query": "mutation CreateBatchCapture($merchant_uid: String!) {\n  createBatchCapture(merchant_uid: $merchant_uid)\n}",
        "variables": {
          "merchant_uid": "example"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createBatchCapture": true
            }
          }
        }
      }
    ]
  },
