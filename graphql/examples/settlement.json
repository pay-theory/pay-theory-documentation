[
  {
    "operation": "settlements",
    "operationType": "query",
    "examples": [
      {
        "name": "List settlements for a merchant",
        "description": "Lists settlements for a merchant.",
        "query": "query Settlements($query: SqlQuery, $limit: Int) {\n  settlements(query: $query, limit: $limit) {\n    items {\n      merchant_uid\n      settlement_batch\n      settlement_date\n      currency\n      gross_amount\n      net_amount\n      total_fees\n      status\n      settlement_type\n      transaction_debit_count\n      transaction_reversal_count\n      transfer_date\n      gross_amount_64bit\n      net_amount_64bit\n    }\n    total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "key": "merchant_uid",
                "value": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                "operator": "EQUAL"
              }
            ]
          },
          "limit": 2
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "settlements": {
                "items": [
                  {
                    "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                    "settlement_batch": 2,
                    "settlement_date": "2026-08-25T00:00:00Z",
                    "currency": "USD",
                    "status": "SUCCEEDED",
                    "settlement_type": "NET",
                    "transaction_debit_count": 1,
                    "transaction_reversal_count": 3,
                    "transfer_date": "2026-08-25T13:31:33.0Z",
                    "gross_amount_64bit": "-400",
                    "net_amount_64bit": "-453",
                    "gross_amount": -400,
                    "net_amount": -453,
                    "total_fees": 53
                  },
                  {
                    "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                    "settlement_batch": 3,
                    "settlement_date": "2026-08-25T00:00:00Z",
                    "currency": "USD",
                    "status": "SUCCEEDED",
                    "settlement_type": "NET",
                    "transaction_debit_count": 5,
                    "transaction_reversal_count": 0,
                    "transfer_date": "2026-08-25T13:32:28.0Z",
                    "gross_amount_64bit": "4000",
