      {
        "name": "Get two settlement batches",
        "description": "Wraps the two settlement_batch filters in query_group, so OR applies only to them and the merchant_uid filter still holds.",
        "query": "query Settlements($query: SqlQuery, $limit: Int) {\n  settlements(query: $query, limit: $limit) {\n    items {\n      merchant_uid\n      settlement_batch\n      settlement_date\n      currency\n      status\n      settlement_type\n      transaction_debit_count\n      transaction_reversal_count\n      transfer_date\n      gross_amount_64bit\n      net_amount_64bit\n    }\n    total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "key": "merchant_uid",
                "value": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                "operator": "EQUAL",
                "conjunctive_operator": "AND_NEXT"
              },
              {
                "query_group": [
                  {
                    "key": "settlement_batch",
                    "value": "2",
                    "operator": "EQUAL",
                    "conjunctive_operator": "OR_NEXT"
                  },
                  {
                    "key": "settlement_batch",
                    "value": "3",
                    "operator": "EQUAL"
                  }
                ]
              }
            ]
          },
          "limit": 10
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "settlements": {
                "items": [
