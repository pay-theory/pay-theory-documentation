    "examples": [
      {
        "name": "Example instruction",
        "description": "Returns instruction.",
        "query": "query Instruction($merchant_uid: ID!, $date: AWSDate!) {\n  instruction(merchant_uid: $merchant_uid, date: $date) {\n  id\n  date\n  amount\n  merchant_uid\n  metadata\n  }\n}",
        "variables": {
          "merchant_uid": "id_123",
          "date": "2025-01-01"
