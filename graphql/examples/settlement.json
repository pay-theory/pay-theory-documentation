  {
    "operation": "createBatchCapture",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Example createBatchCapture",
        "description": "This mutation will capture all PENDING transactions for a merchant in a batch and shortly after create a settlement for the merchant.",
        "query": "mutation CreateBatchCapture($merchant_uid: String!) {\n  createBatchCapture(merchant_uid: $merchant_uid)\n}",
        "variables": {
          "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createBatchCapture": true
            }
          }
        }
      }
    ]
  },
