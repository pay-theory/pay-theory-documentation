    "operation": "authorizations",
    "operationType": "query",
    "examples": [
      {
        "name": "Example authorizations",
        "description": "This query will return a list of authorizations for a merchant.",
        "query": "query Authorizations($query: SqlQuery, $limit: Int, $offset: String, $direction: MoveDirection, $offset_id: String) {\n  authorizations(query: $query, limit: $limit, offset: $offset, direction: $direction, offset_id: $offset_id) {\n  items {\n    authorization_id\n    authorization_date\n    account_code\n    amount\n    avs_status\n  }\n  total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "conjunctive_operator": "AND_NEXT"
              }
            ],
            "sort_list": [
              {
                "direction": "ASC"
              }
            ]
          },
          "limit": 123,
          "offset": "example",
          "direction": "BACKWARD",
          "offset_id": "example"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "authorizations": {
                "items": [
                  {
                    "authorization_id": "example",
                    "authorization_date": "2025-01-01T00:00:00Z",
                    "account_code": "example",
                    "amount": 123,
                    "avs_status": "example"
                  }
                ],
                "total_row_count": 123
              }
            }
          }
        }
      }
    ]
  },
