      {
        "name": "Example users",
        "description": "Requires a partner key.",
        "query": "query Users($user_pool: UserPool!, $merchant_uid: String) {\n  users(user_pool: $user_pool, merchant_uid: $merchant_uid) {\n  email\n  full_name\n  phone\n  user_status\n  username\n  }\n}",
        "variables": {
          "user_pool": "MERCHANT",
          "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "users": {
                "email": "example",
                "full_name": "example",
                "phone": "example",
                "user_status": "example",
                "username": "example"
              }
            }
          }
        }
      }
    ]
  },
