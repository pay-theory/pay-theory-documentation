[
  {
    "operation": "paymentLinks",
    "operationType": "query",
    "examples": [
      {
        "name": "List active payment links",
        "description": "Lists a merchant’s active links, newest first.",
        "query": "query PaymentLinks($query: SqlQuery, $limit: Int) {\n  paymentLinks(query: $query, limit: $limit) {\n    items {\n      link_id\n      link_name\n      link_url\n      merchant_uid\n      amount\n      amount_is_variable\n      min_amount\n      accepted_payment_methods\n      account_code\n      call_to_action\n      created_date\n      currency\n      custom_success_message\n      fee_mode\n      is_active\n      payment_name\n      payment_description\n      redirect_url\n      require_phone\n    }\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "conjunctive_operator": "AND_NEXT",
                "key": "merchant_uid",
                "operator": "EQUAL",
                "value": "e9f2387b-8727-450a-w3g2-fee9b49e42a1"
              },
              {
                "key": "is_active",
                "operator": "EQUAL_TRUE"
              }
            ],
            "sort_list": [
              {
                "direction": "DESC",
                "key": "created_date"
              }
            ]
          },
          "limit": 2
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "paymentLinks": {
                "items": [
                  {
                    "link_id": "ptl_link_6oLR7QBSFPe1kr2NKP4A2O",
                    "link_name": "Spring workshop",
                    "link_url": "https://pt.checkout.paytheory.com/payment_link/ptl_link_6oLR7QBSFPe1kr2NKP4A2O",
                    "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                    "amount": 2500,
                    "amount_is_variable": false,
                    "min_amount": 100,
                    "accepted_payment_methods": "ONLY_CARD",
                    "account_code": null,
                    "call_to_action": "PAY",
                    "created_date": "2026-09-05T03:56:52.0Z",
                    "currency": "USD",
                    "custom_success_message": null,
                    "fee_mode": "MERCHANT_FEE",
                    "is_active": true,
                    "payment_name": "Spring workshop",
                    "payment_description": "One seat at the spring workshop",
                    "redirect_url": null,
                    "require_phone": false
                  },
                  {
