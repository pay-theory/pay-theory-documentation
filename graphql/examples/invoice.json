    "examples": [
      {
        "name": "Example createOfflineTransaction",
        "description": "This call is used to create an offline transaction for an invoice. Offline transactions are used to track payments that are made outside Pay Theory toward an Invoice.",
        "query": "mutation CreateOfflineTransaction($input: OfflineTransactionInput!) {\n  createOfflineTransaction(input: $input) {\n  instance_id\n  transaction_date\n  amount\n  invoice_id\n  note\n  }\n}",
        "variables": {
          "input": {
            "amount": 123,
            "invoice_id": "example",
            "note": "example",
            "transaction_date": "2025-01-01",
            "type": "ACH"
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createOfflineTransaction": {
                "instance_id": "example",
                "transaction_date": "2025-01-01",
