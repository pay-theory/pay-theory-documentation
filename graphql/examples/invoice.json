[
  {
    "operation": "invoices",
    "operationType": "query",
    "examples": [
      {
        "name": "Get a paid invoice",
        "description": "status is PAID and total_paid_amount equals invoice_amount.",
        "query": "query Invoices($query: SqlQuery, $limit: Int) {\n  invoices(query: $query, limit: $limit) {\n    items {\n      invoice_id\n      merchant_uid\n      invoice_name\n      invoice_description\n      invoice_amount\n      total_paid_amount\n      currency\n      status\n      fee_mode\n      due_by\n      invoice_date\n      merchant_invoice_number\n      account_code\n      reference\n      created_date\n      settings {\n        is_secure\n        security_pin\n        require_payor_address\n        accepted_payment_methods { ach card cash }\n      }\n      payor {\n        payor_id\n        full_name\n        email\n        merchant_uid\n      }\n      metadata\n      offline_transactions { instance_id amount type note transaction_date }\n    }\n    total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "key": "invoice_id",
                "value": "ptl_inv_3G68AxWreHdbCOWcdCKmpW",
                "operator": "EQUAL"
              }
            ]
          },
          "limit": 1
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "invoices": {
                "items": [
                  {
                    "invoice_id": "ptl_inv_3G68AxWreHdbCOWcdCKmpW",
                    "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                    "invoice_name": "Spring cleaning",
                    "invoice_description": "Two hours of deep cleaning",
                    "invoice_amount": 2500,
                    "total_paid_amount": 2500,
                    "currency": "USD",
                    "status": "PAID",
                    "fee_mode": "MERCHANT_FEE",
                    "due_by": "2026-10-05",
                    "invoice_date": "2026-09-05",
                    "merchant_invoice_number": null,
                    "account_code": "CLEANING-1001",
                    "reference": "INV-1001",
                    "created_date": "2026-09-05T00:12:25.0Z",
                    "settings": null,
                    "payor": {
                      "payor_id": "ptl_pay_3FUmPZJT65KZ0MRttPfmBi",
                      "full_name": "Pat Theodore",
                      "email": "pat@paytheory.com",
                      "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1"
                    },
                    "metadata": "{}",
                    "offline_transactions": [
                      {
                        "instance_id": "3WIrDmgG9VloBTPg1lwsKo",
                        "amount": 2500,
                        "type": "CASH",
                        "note": "Paid at the front desk",
                        "transaction_date": "2026-09-05"
                      }
                    ]
                  }
                ],
                "total_row_count": 1
              }
            }
          }
        }
      }
    ]
  },
  {
    "operation": "createInvoice",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Create an invoice with metadata",
        "description": "Creates a $25.00 invoice and a new payor in one call. Send metadata as a JSON string.",
        "query": "mutation CreateInvoice($input: InvoiceInput!) {\n  createInvoice(input: $input) {\n    invoice_id\n    merchant_uid\n    invoice_name\n    invoice_description\n    invoice_amount\n    total_paid_amount\n    currency\n    status\n    fee_mode\n    due_by\n    invoice_date\n    merchant_invoice_number\n    account_code\n    reference\n    created_date\n    settings {\n      is_secure\n      security_pin\n      require_payor_address\n      accepted_payment_methods { ach card cash }\n    }\n    payor {\n      payor_id\n      full_name\n      email\n      merchant_uid\n    }\n  }\n}",
        "variables": {
          "input": {
            "currency": "USD",
            "invoice_amount": 2500,
            "invoice_name": "Spring cleaning",
            "invoice_description": "Two hours of deep cleaning",
            "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
            "due_by": "2026-10-05",
            "fee_mode": "MERCHANT_FEE",
            "reference": "INV-1001",
            "account_code": "CLEANING-1001",
            "send_email": false,
            "payor": {
              "email": "pat@paytheory.com",
              "full_name": "Pat Theodore"
            },
            "metadata": "{\"order_id\":\"INV-1001\"}"
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createInvoice": {
                "invoice_id": "ptl_inv_2O0yTY3k5AIyDc8NQ2SvhC",
                "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                "invoice_name": "Spring cleaning",
                "invoice_description": "Two hours of deep cleaning",
                "invoice_amount": 2500,
                "total_paid_amount": 0,
                "currency": "USD",
                "status": "NOT_PAID",
                "fee_mode": "MERCHANT_FEE",
                "due_by": "2026-10-05",
                "invoice_date": "2026-09-05",
                "merchant_invoice_number": null,
                "account_code": "CLEANING-1001",
                "reference": "INV-1001",
                "created_date": "2026-09-05T00:11:36.0Z",
                "settings": null,
                "payor": {
                  "payor_id": "ptl_pay_2NM2STwd3pWznLo1hGnUSc",
                  "full_name": "Pat Theodore",
                  "email": "pat@paytheory.com",
                  "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1"
                }
              }
            }
          }
        }
      }
    ]
  },
  {
    "operation": "updateInvoice",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Update an invoice",
        "description": "Changes an invoice's amount, name, and due date.",
        "query": "mutation UpdateInvoice($invoice_id: String!, $invoice_update_input: InvoiceUpdateInput!) {\n  updateInvoice(invoice_id: $invoice_id, invoice_update_input: $invoice_update_input)\n}",
        "variables": {
          "invoice_id": "ptl_inv_33Lz4PE1amu7bfIfufo0rS",
          "invoice_update_input": {
            "due_by": "2026-10-20",
            "invoice_amount": 3000,
            "invoice_name": "Spring cleaning (revised)",
            "send_email": false
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "updateInvoice": true
            }
          }
        }
      }
    ]
  },
  {
    "operation": "deleteInvoice",
