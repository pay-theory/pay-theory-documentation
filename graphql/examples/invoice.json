          "invoice_id": "ptl_inv_4VAqBS9kDpdBAOqzjqj81G"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "deleteInvoice": true
            }
          }
        }
      },
      {
        "name": "Unknown invoice ID",
        "description": "Attempts to delete the invoice identified by invoice_id.",
        "query": "mutation DeleteInvoice($invoice_id: String!) {\n  deleteInvoice(invoice_id: $invoice_id)\n}",
        "variables": {
          "invoice_id": "ptl_inv_does_not_exist"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "deleteInvoice": true
            }
          }
        }
      }
    ]
  },
