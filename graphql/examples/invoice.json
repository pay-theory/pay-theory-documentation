[
  {
    "operation": "invoices",
    "operationType": "query",
    "examples": [
      {
        "name": "Example invoices",
        "description": "Returns invoices.",
        "query": "query Invoices($query: SqlQuery, $limit: Int, $offset: String, $direction: MoveDirection, $offset_id: String) {\n  invoices(query: $query, limit: $limit, offset: $offset, direction: $direction, offset_id: $offset_id) {\n  items {\n    invoice_id\n    created_date\n    account_code\n    currency\n    due_by\n  }\n  total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "conjunctive_operator": "AND_NEXT"
              }
            ],
            "sort_list": [
              {
                "direction": "ASC"
              }
            ]
          },
          "limit": 123,
          "offset": "example",
          "direction": "BACKWARD",
          "offset_id": "example"
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "invoices": {
                "items": [
                  {
                    "invoice_id": "example",
                    "created_date": "2025-01-01T00:00:00Z",
                    "account_code": "example",
                    "currency": "example",
                    "due_by": "2025-01-01"
                  }
                ],
                "total_row_count": 123
              }
            }
          }
        }
      }
    ]
  },
  {
    "operation": "createInvoice",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Example createInvoice",
        "description": "Creates an invoice.",
        "query": "mutation CreateInvoice($input: InvoiceInput!) {\n  createInvoice(input: $input) {\n  invoice_id\n  created_date\n  account_code\n  currency\n  due_by\n  }\n}",
        "variables": {
          "input": {
            "account_code": "example",
            "currency": "example",
            "due_by": "2025-01-01",
            "fee_mode": "CUSTOM_FEE",
            "invoice_amount": 123,
            "invoice_date": "2025-01-01",
            "invoice_description": "example",
            "invoice_name": "example",
            "merchant_uid": "example",
            "merchant_invoice_number": "example",
            "metadata": {
              "key": "value"
            },
            "payor_id": "example",
            "payor": {
              "address_line1": "example"
            },
            "reference": "example",
            "send_email": true,
            "settings": {
              "accepted_payment_methods": {
                "ach": true
              }
            }
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createInvoice": {
                "invoice_id": "example",
                "created_date": "2025-01-01T00:00:00Z",
                "account_code": "example",
                "currency": "example",
                "due_by": "2025-01-01"
              }
            }
          }
        }
      }
    ]
  },
