[
  {
    "operation": "invoices",
    "operationType": "query",
    "examples": [
      {
        "name": "List invoices for a merchant",
        "description": "Lists a merchant\u2019s invoices, newest first.",
        "query": "query Invoices($query: SqlQuery, $limit: Int) {\n  invoices(query: $query, limit: $limit) {\n    items {\n      invoice_id\n      created_date\n      account_code\n      currency\n      due_by\n    }\n    total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "key": "merchant_uid",
                "value": "9f0acb5e-a176-404a-b735-f4caac66098e",
                "operator": "EQUAL"
              }
            ],
            "sort_list": [
              {
                "direction": "DESC",
                "key": "created_date"
              }
            ]
          },
          "limit": 1
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "invoices": {
                "items": [
                  {
                    "invoice_id": "ptl_inv_1DzHEBH1H6B333RHheYeGR",
                    "created_date": "2026-09-24T14:57:07.0Z",
                    "account_code": null,
                    "currency": "USD",
                    "due_by": null
                  }
                ],
                "total_row_count": 434
              }
            }
          }
        }
      }
    ]
  },
  {
    "operation": "createInvoice",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Example createInvoice",
        "description": "Creates an invoice.",
        "query": "mutation CreateInvoice($input: InvoiceInput!) {\n  createInvoice(input: $input) {\n  invoice_id\n  created_date\n  account_code\n  currency\n  due_by\n  }\n}",
        "variables": {
          "input": {
            "account_code": "example",
            "currency": "example",
            "due_by": "2025-01-01",
            "fee_mode": "CUSTOM_FEE",
            "invoice_amount": 123,
            "invoice_date": "2025-01-01",
            "invoice_description": "example",
            "invoice_name": "example",
            "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
            "merchant_invoice_number": "example",
            "metadata": {
              "key": "value"
            },
            "payor_id": "example",
            "payor": {
              "address_line1": "example"
            },
            "reference": "example",
            "send_email": true,
            "settings": {
              "accepted_payment_methods": {
                "ach": true
              }
            }
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createInvoice": {
                "invoice_id": "example",
                "created_date": "2025-01-01T00:00:00Z",
                "account_code": "example",
                "currency": "example",
                "due_by": "2025-01-01"
              }
            }
          }
        }
      }
    ]
  },
