        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createInvoiceEmail": true
            }
          }
        }
      }
    ]
  },
  {
    "operation": "createOfflineTransaction",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Record a cash payment",
        "description": "Records a cash payment against an invoice. The amount must equal the remaining balance.",
        "query": "mutation CreateOfflineTransaction($input: OfflineTransactionInput!) {\n  createOfflineTransaction(input: $input) {\n    instance_id\n    invoice_id\n    amount\n    type\n    note\n    transaction_date\n  }\n}",
        "variables": {
          "input": {
            "amount": 2500,
            "invoice_id": "ptl_inv_3G68AxWreHdbCOWcdCKmpW",
            "note": "Paid at the front desk",
            "transaction_date": "2026-09-05",
            "type": "CASH"
          }
        },
        "response": {
          "type": "success",
          "httpStatus": 200,
          "body": {
            "data": {
              "createOfflineTransaction": {
                "instance_id": "3WIrDmgG9VloBTPg1lwsKo",
                "invoice_id": "ptl_inv_3G68AxWreHdbCOWcdCKmpW",
                "amount": 2500,
                "type": "CASH",
                "note": "Paid at the front desk",
                "transaction_date": "2026-09-05"
              }
            }
          }
        }
      }
    ]
  }
