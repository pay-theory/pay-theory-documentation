  {
    "operation": "createRecurringPayment",
    "operationType": "mutation",
    "examples": [
      {
        "name": "Create a monthly schedule that starts in the future",
        "description": "A future first_payment_date schedules the first charge for that date. If you omit it or set it to today's date, the first charge happens immediately.",
        "query": "mutation CreateRecurringPayment($input: RecurringPaymentInput!) {\n  createRecurringPayment(input: $input) {\n    recurring_id\n    merchant_uid\n    recurring_name\n    recurring_description\n    amount_per_payment\n    fee_per_payment\n    total_amount_per_payment\n    fee_mode\n    payment_interval\n    prev_payment_date\n    next_payment_date\n    remaining_payments\n    status\n    is_active\n    mute_all_emails\n    account_code\n    reference\n    created_date\n    payment_method {\n      payment_method_id\n      last_four\n      payment_type\n    }\n    payor {\n      payor_id\n      full_name\n      email\n    }\n  }\n}",
        "variables": {
          "input": {
            "merchant_uid": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
