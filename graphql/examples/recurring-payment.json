[
  {
    "operation": "recurringPayments",
    "operationType": "query",
    "examples": [
      {
        "name": "List a merchant's recurring schedules",
        "description": "Lists a merchant's recurring schedules.",
        "query": "query RecurringPayments($query: SqlQuery, $limit: Int, $offset: String, $offset_id: String, $direction: MoveDirection) {\n  recurringPayments(query: $query, limit: $limit, offset: $offset, offset_id: $offset_id, direction: $direction) {\n    items {\n      recurring_id\n      merchant_uid\n      recurring_name\n      amount_per_payment\n      fee_per_payment\n      total_amount_per_payment\n      fee_mode\n      payment_interval\n      prev_payment_date\n      next_payment_date\n      remaining_payments\n      status\n      is_active\n      created_date\n    }\n    total_row_count\n  }\n}",
        "variables": {
          "query": {
            "query_list": [
              {
                "key": "merchant_uid",
                "value": "e9f2387b-8727-450a-w3g2-fee9b49e42a1",
                "operator": "EQUAL"
              }
